# 이 파일을 .env.local로 복사해서 값을 채운다. .env.local은 절대 GitHub에 올리지 않는다.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# 서버 전용 비밀 키. 이 값은 절대 NEXT_PUBLIC_ 이름으로 만들지 않는다.
SUPABASE_SECRET_KEY=sb_secret_xxx

# 토스페이먼츠 (개발자센터 → API 키). 처음엔 test_ 키로 시작한다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_xxx
TOSS_SECRET_KEY=test_gsk_xxx

# Vercel Cron이 자동 삭제 작업을 호출할 때 쓰는 비밀값 (아무 긴 무작위 문자열)
CRON_SECRET=

# 카카오 알림톡 (솔라피). 비워 두면 알림을 보내지 않는다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=
SOLAPI_SENDER=
SOLAPI_TEMPLATE_PAID=
SOLAPI_TEMPLATE_DELIVERED=
